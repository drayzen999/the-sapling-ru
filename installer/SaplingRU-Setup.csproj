<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SaplingRU-Setup</AssemblyName>
    <RootNamespace>SaplingRU</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="patches\*.srup" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="patches\manifest.txt" LogicalName="manifest.txt" />
  </ItemGroup>
</Project>
